        const defaultCustomDateSchedules = {
            "2026-02-16": [
                { start: "08:00", end: "10:00", title: "Accueil Vacances de Février", desc: "Petit déjeuner et jeux de société.", picto: "https://img.icons8.com/color/96/sun.png", bg: "https://images.unsplash.com/photo-1530549387789-4c1017266635?auto=format&fit=crop&w=1920&q=80" },
                { start: "10:00", end: "12:00", title: "Grand Tournoi des Vacances", desc: "Olympiades en équipes !", picto: "https://img.icons8.com/color/96/trophy.png", bg: "https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=1920&q=80" }
            ]
        };

        const defaultDesign = {
            fontFamily: "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif",
            clockX: "50", clockY: "12", clockW: "60",
            mainX: "50", mainY: "50", mainW: "80",
            footerX: "50", footerY: "88", footerW: "90",
            progressBarHeight: "80", clockFont: "8", titleFont: "3.5", descFont: "2",
            borderVisibility: "visible",
            progressBarBorder: "none",
            progressBorderColor: "#ffcc00",
            clockBorder: "solid", clockBg: "show",
            mainBorder: "solid", mainBg: "show",
            footerBorder: "solid", footerBg: "show",
            border: "#ffcc00", containerBg: "#000000",
            clockText: "#ffffff", dayText: "#ffcc00", titleText: "#ffcc00", descText: "#ffffff", footerText: "#ffffff",
            progressStart: "#4facfe", progressEnd: "#ff8008",
            soundEnabled: "true", customSoundData: ""
        };

        let weeklySchedules = JSON.parse(localStorage.getItem('centre_weekly_schedules')) || defaultWeeklySchedules;
        let customDateSchedules = JSON.parse(localStorage.getItem('centre_custom_date_schedules')) || defaultCustomDateSchedules;
        let currentDesign = JSON.parse(localStorage.getItem('centre_design_clc_v1')) || JSON.parse(localStorage.getItem('centre_design_xy_v8')) || defaultDesign;
        
        let currentAdminDay = 1;
        let selectedCalendarDate = new Date().toISOString().split('T')[0];
        let currentScheduleMode = 'weekly';
        let previousActivityTitle = "";
        let previewSlotOverride = null;

        // RENDU DE L'HORLOGE A CELLULES FIXES (PAR CHIFFRE / SEPARATEUR)
        function setClockText(timeStr) {
            const clockEl = document.getElementById('clock');
            if (!clockEl) return;
            
            // Si le nombre de cellules ne correspond pas, réinitialiser la structure HTML
            if (clockEl.children.length !== timeStr.length) {
                clockEl.innerHTML = '';
                for (let i = 0; i < timeStr.length; i++) {
                    const char = timeStr[i];
                    const span = document.createElement('span');
                    if (char === ':') {
                        span.className = 'clock-colon';
                        span.textContent = ':';
                    } else {
                        span.className = 'clock-digit';
                        span.textContent = char;
                    }
                    clockEl.appendChild(span);
                }
            } else {
                for (let i = 0; i < timeStr.length; i++) {
                    if (clockEl.children[i].textContent !== timeStr[i]) {
                        clockEl.children[i].textContent = timeStr[i];
                    }
                }
            }
        }

        function applyDesign() {
            document.documentElement.style.setProperty('--app-font-family', currentDesign.fontFamily);
            document.documentElement.style.setProperty('--clock-x', `${currentDesign.clockX}%`);
            document.documentElement.style.setProperty('--clock-y', `${currentDesign.clockY}%`);
            
            let clockWidthVal = currentDesign.clockW && currentDesign.clockW !== "60" ? `${currentDesign.clockW}%` : 'auto';
            document.documentElement.style.setProperty('--clock-w', clockWidthVal);
            
            document.documentElement.style.setProperty('--main-x', `${currentDesign.mainX}%`);
            document.documentElement.style.setProperty('--main-y', `${currentDesign.mainY}%`);
            document.documentElement.style.setProperty('--main-w', `${currentDesign.mainW}%`);
            document.documentElement.style.setProperty('--footer-x', `${currentDesign.footerX}%`);
            document.documentElement.style.setProperty('--footer-y', `${currentDesign.footerY}%`);
            document.documentElement.style.setProperty('--footer-w', `${currentDesign.footerW}%`);
            document.documentElement.style.setProperty('--progress-bar-height', `${currentDesign.progressBarHeight}px`);
            document.documentElement.style.setProperty('--clock-font-size', `${currentDesign.clockFont}rem`);
            document.documentElement.style.setProperty('--title-font-size', `${currentDesign.titleFont}rem`);
            document.documentElement.style.setProperty('--desc-font-size', `${currentDesign.descFont}rem`);

            let isGlobalBorderVisible = (currentDesign.borderVisibility !== "none");
            let borderColor = isGlobalBorderVisible ? currentDesign.border : "transparent";

            document.documentElement.style.setProperty('--border-color', borderColor);
            document.documentElement.style.setProperty('--progress-border-color', currentDesign.progressBorderColor || currentDesign.border || "#ffcc00");
            document.documentElement.style.setProperty('--clock-border-style', currentDesign.clockBorder);
            document.documentElement.style.setProperty('--main-border-style', currentDesign.mainBorder);
            document.documentElement.style.setProperty('--footer-border-style', currentDesign.footerBorder);
            document.documentElement.style.setProperty('--progress-border-style', currentDesign.progressBarBorder || "none");
            document.documentElement.style.setProperty('--picto-border-style', isGlobalBorderVisible ? "solid" : "none");

            let hexBg = currentDesign.containerBg || '#000000';
            let r = parseInt(hexBg.substr(1,2),16), g = parseInt(hexBg.substr(3,2),16), b = parseInt(hexBg.substr(5,2),16);
            let rgbaVal = `rgba(${r}, ${g}, ${b}, 0.75)`;

            document.documentElement.style.setProperty('--clock-bg-style', currentDesign.clockBg === 'hide' ? 'transparent' : rgbaVal);
            document.documentElement.style.setProperty('--main-bg-style', currentDesign.mainBg === 'hide' ? 'transparent' : rgbaVal);
            document.documentElement.style.setProperty('--footer-bg-style', currentDesign.footerBg === 'hide' ? 'transparent' : rgbaVal);

            document.documentElement.style.setProperty('--clock-text-color', currentDesign.clockText);
            document.documentElement.style.setProperty('--day-text-color', currentDesign.dayText);
            document.documentElement.style.setProperty('--title-text-color', currentDesign.titleText);
            document.documentElement.style.setProperty('--desc-text-color', currentDesign.descText);
            document.documentElement.style.setProperty('--footer-text-color', currentDesign.footerText);
            document.documentElement.style.setProperty('--primary-color', currentDesign.titleText);
            document.documentElement.style.setProperty('--progress-start-color', currentDesign.progressStart);
            document.documentElement.style.setProperty('--progress-end-color', currentDesign.progressEnd);

            const fontSelect = document.getElementById('selectFontFamily');
            if(fontSelect) fontSelect.value = currentDesign.fontFamily;

            const borderVisSelect = document.getElementById('selectBorderVisibility');
            if(borderVisSelect) borderVisSelect.value = currentDesign.borderVisibility || "visible";

            const progressBorderSelect = document.getElementById('selectProgressBarBorder');
            if(progressBorderSelect) progressBorderSelect.value = currentDesign.progressBarBorder || "none";

            const pickers = {
                'pickerBorder': currentDesign.border,
                'pickerProgressBorder': currentDesign.progressBorderColor || currentDesign.border || "#ffcc00",
                'pickerContainerBg': currentDesign.containerBg,
                'pickerClockText': currentDesign.clockText,
                'pickerDayText': currentDesign.dayText,
                'pickerTitleText': currentDesign.titleText,
                'pickerDescText': currentDesign.descText,
                'pickerFooterText': currentDesign.footerText,
                'pickerProgressStart': currentDesign.progressStart,
                'pickerProgressEnd': currentDesign.progressEnd
            };
            for(let id in pickers) {
                const el = document.getElementById(id);
                if(el) el.value = pickers[id];
            }

            ['ClockX', 'ClockY', 'ClockW', 'MainX', 'MainY', 'MainW', 'FooterX', 'FooterY', 'FooterW'].forEach(id => {
                const el = document.getElementById(`range${id}`);
                if(el) {
                    el.value = currentDesign[id.charAt(0).toLowerCase() + id.slice(1)];
                    document.getElementById(`val${id}`).textContent = `${el.value}%`;
                }
            });
            document.getElementById('rangeProgressBarH').value = currentDesign.progressBarHeight;
            document.getElementById('valProgressBarH').textContent = `${currentDesign.progressBarHeight}px`;
            document.getElementById('rangeClockFont').value = currentDesign.clockFont;
            document.getElementById('valClockFont').textContent = `${currentDesign.clockFont}rem`;
            document.getElementById('rangeTitleFont').value = currentDesign.titleFont;
            document.getElementById('valTitleFont').textContent = `${currentDesign.titleFont}rem`;
            document.getElementById('rangeDescFont').value = currentDesign.descFont;
            document.getElementById('valDescFont').textContent = `${currentDesign.descFont}rem`;
            document.getElementById('soundEnabledSelect').value = currentDesign.soundEnabled || "true";
        }

        function updateDesignSettings() {
            currentDesign.fontFamily = document.getElementById('selectFontFamily').value;
            currentDesign.border = document.getElementById('pickerBorder').value;
            currentDesign.progressBorderColor = document.getElementById('pickerProgressBorder').value;
            currentDesign.borderVisibility = document.getElementById('selectBorderVisibility').value;
            currentDesign.progressBarBorder = document.getElementById('selectProgressBarBorder').value;
            currentDesign.containerBg = document.getElementById('pickerContainerBg').value;
            currentDesign.clockText = document.getElementById('pickerClockText').value;
            currentDesign.dayText = document.getElementById('pickerDayText').value;
            currentDesign.titleText = document.getElementById('pickerTitleText').value;
            currentDesign.descText = document.getElementById('pickerDescText').value;
            currentDesign.footerText = document.getElementById('pickerFooterText').value;
            currentDesign.progressStart = document.getElementById('pickerProgressStart').value;
            currentDesign.progressEnd = document.getElementById('pickerProgressEnd').value;
            currentDesign.soundEnabled = document.getElementById('soundEnabledSelect').value;

            ['ClockX', 'ClockY', 'ClockW', 'MainX', 'MainY', 'MainW', 'FooterX', 'FooterY', 'FooterW'].forEach(id => {
                currentDesign[id.charAt(0).toLowerCase() + id.slice(1)] = document.getElementById(`range${id}`).value;
            });
            currentDesign.clockBorder = document.getElementById('selectClockBorder').value;
            currentDesign.clockBg = document.getElementById('selectClockBg').value;
            currentDesign.mainBorder = document.getElementById('selectMainBorder').value;
            currentDesign.mainBg = document.getElementById('selectMainBg').value;
            currentDesign.footerBorder = document.getElementById('selectFooterBorder').value;
            currentDesign.footerBg = document.getElementById('selectFooterBg').value;
            currentDesign.progressBarHeight = document.getElementById('rangeProgressBarH').value;
            currentDesign.clockFont = document.getElementById('rangeClockFont').value;
            currentDesign.titleFont = document.getElementById('rangeTitleFont').value;
            currentDesign.descFont = document.getElementById('rangeDescFont').value;
            applyDesign();
        }

        function switchScheduleMode(mode) {
            currentScheduleMode = mode;
            document.getElementById('btnModeWeekly').classList.toggle('active', mode === 'weekly');
            document.getElementById('btnModeCustom').classList.toggle('active', mode === 'custom');
            document.getElementById('sectionWeeklySchedule').style.display = mode === 'weekly' ? 'block' : 'none';
            document.getElementById('sectionCustomSchedule').style.display = mode === 'custom' ? 'block' : 'none';
            if (mode === 'custom') {
                document.getElementById('calendarDatePicker').value = selectedCalendarDate;
                renderCustomDateForm();
            } else {
                renderWeeklyForm();
            }
        }

        function onCalendarDateChange() {
            selectedCalendarDate = document.getElementById('calendarDatePicker').value;
            renderCustomDateForm();
        }

        function applyRangeToVacation() {
            const startStr = document.getElementById('rangeStartDate').value;
            const endStr = document.getElementById('rangeEndDate').value;
            if (!startStr || !endStr) {
                alert("Veuillez sélectionner une date de début et une date de fin.");
                return;
            }
            let startDate = new Date(startStr), endDate = new Date(endStr);
            if (startDate > endDate) {
                alert("La date de début doit être antérieure ou égale à la date de fin.");
                return;
            }
            let sourceSlots = customDateSchedules[selectedCalendarDate];
            if (!sourceSlots || sourceSlots.length === 0) {
                sourceSlots = [{ start: "08:00", end: "17:00", title: "Activité Vacances", desc: "Programme de la journée.", picto: "https://img.icons8.com/color/96/sun.png", bg: "https://images.unsplash.com/photo-1530549387789-4c1017266635?auto=format&fit=crop&w=1920&q=80" }];
            }
            let count = 0, curr = new Date(startDate);
            while (curr <= endDate) {
                let y = curr.getFullYear(), m = String(curr.getMonth() + 1).padStart(2, '0'), d = String(curr.getDate()).padStart(2, '0');
                customDateSchedules[`${y}-${m}-${d}`] = JSON.parse(JSON.stringify(sourceSlots));
                count++;
                curr.setDate(curr.getDate() + 1);
            }
            alert(`Succès ! Appliqué à ${count} jours.`);
            renderCustomDateForm();
        }

        function renderWeeklyForm() {
            const container = document.getElementById('weeklyScheduleForm');
            container.innerHTML = '';
            (weeklySchedules[currentAdminDay] || []).forEach((item, index) => {
                container.appendChild(createSlotFormItem(item, 'weekly', currentAdminDay, index));
            });
        }

        function renderCustomDateForm() {
            const container = document.getElementById('customScheduleForm');
            container.innerHTML = '';
            if (!customDateSchedules[selectedCalendarDate]) {
                container.innerHTML = `<p style="padding: 15px; color: #aaa; text-align: center;">Aucun planning spécifique pour le <strong>${selectedCalendarDate}</strong>.</p>`;
                return;
            }
            customDateSchedules[selectedCalendarDate].forEach((item, index) => {
                container.appendChild(createSlotFormItem(item, 'custom', selectedCalendarDate, index));
            });
        }

        function createSlotFormItem(item, mode, key, index) {
            const itemEl = document.createElement('div');
            itemEl.className = 'admin-item';
            itemEl.innerHTML = `
                <div class="form-group">
                    <label>Heure de début</label>
                    <input type="time" value="${item.start}" onchange="updateSlotProp('${mode}', '${key}', ${index}, 'start', this.value)">
                </div>
                <div class="form-group">
                    <label>Heure de fin</label>
                    <input type="time" value="${item.end}" onchange="updateSlotProp('${mode}', '${key}', ${index}, 'end', this.value)">
                </div>
                <div class="form-group">
                    <label>Titre</label>
                    <input type="text" value="${item.title}" onchange="updateSlotProp('${mode}', '${key}', ${index}, 'title', this.value)">
                </div>
                <div class="form-group">
                    <label>Pictogramme</label>
                    <input type="text" value="${item.picto.startsWith('data:') ? '[Fichier importé]' : item.picto}" onchange="if(!this.value.startsWith('[Fichier')) updateSlotProp('${mode}', '${key}', ${index}, 'picto', this.value)">
                    <div class="file-upload-preview">
                        <input type="file" accept="image/*" onchange="handleImageUpload(event, '${mode}', '${key}', ${index}, 'picto')">
                        ${item.picto ? `<img src="${item.picto}">` : ''}
                    </div>
                </div>
                <div class="form-group full-width">
                    <label>Image de Fond</label>
                    <input type="text" value="${item.bg.startsWith('data:') ? '[Fichier importé]' : item.bg}" onchange="if(!this.value.startsWith('[Fichier')) updateSlotProp('${mode}', '${key}', ${index}, 'bg', this.value)">
                    <div class="file-upload-preview">
                        <input type="file" accept="image/*" onchange="handleImageUpload(event, '${mode}', '${key}', ${index}, 'bg')">
                    </div>
                </div>
                <div class="form-group full-width">
                    <label>Description</label>
                    <textarea onchange="updateSlotProp('${mode}', '${key}', ${index}, 'desc', this.value)">${item.desc}</textarea>
                    <div style="display: flex; gap: 10px; margin-top: 10px;">
                        <button class="btn-delete" style="margin-top:0;" onclick="deleteSlot('${mode}', '${key}', ${index})">🗑️ Supprimer</button>
                        <button class="btn-preview-mode" style="padding: 6px 12px; font-size: 0.9rem;" onclick="previewSpecificSlot('${mode}', '${key}', ${index})">👁️ Prévisualiser ce créneau</button>
                    </div>
                </div>
            `;
            return itemEl;
        }

        function updateSlotProp(mode, key, index, prop, value) {
            if (mode === 'weekly') weeklySchedules[key][index][prop] = value;
            else customDateSchedules[key][index][prop] = value;
        }

        function addWeeklySlot() {
            if (!weeklySchedules[currentAdminDay]) weeklySchedules[currentAdminDay] = [];
            weeklySchedules[currentAdminDay].push({ start: "14:00", end: "16:00", title: "Nouvelle Activité", desc: "Description...", picto: "https://img.icons8.com/color/96/clock.png", bg: "https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=1920&q=80" });
            renderWeeklyForm();
        }

        function addCustomSlot() {
            if (!customDateSchedules[selectedCalendarDate]) customDateSchedules[selectedCalendarDate] = [];
            customDateSchedules[selectedCalendarDate].push({ start: "09:00", end: "12:00", title: "Activité Spéciale", desc: "Description...", picto: "https://img.icons8.com/color/96/sun.png", bg: "https://images.unsplash.com/photo-1530549387789-4c1017266635?auto=format&fit=crop&w=1920&q=80" });
            renderCustomDateForm();
        }

        function deleteSlot(mode, key, index) {
            if (mode === 'weekly') weeklySchedules[key].splice(index, 1), renderWeeklyForm();
            else customDateSchedules[key].splice(index, 1), renderCustomDateForm();
        }

        function deleteCustomDateSchedule() {
            if (customDateSchedules[selectedCalendarDate]) {
                delete customDateSchedules[selectedCalendarDate];
                renderCustomDateForm();
                alert("Planning de la date supprimé.");
            }
        }

        function previewSpecificSlot(mode, key, index) {
            let slot = mode === 'weekly' ? weeklySchedules[key][index] : customDateSchedules[key][index];
            previewSlotOverride = JSON.parse(JSON.stringify(slot));
            closeAdmin();
            document.getElementById('previewBanner').classList.add('active');
            updateAppForce(previewSlotOverride);
        }

        function previewCurrentEditedSlot() {
            let slot = null;
            if (currentScheduleMode === 'weekly') {
                slot = (weeklySchedules[currentAdminDay] || [])[0];
            } else {
                slot = (customDateSchedules[selectedCalendarDate] || [])[0];
            }
            if (!slot) {
                alert("Veuillez d'abord créer au moins un créneau à prévisualiser.");
                return;
            }
            previewSlotOverride = JSON.parse(JSON.stringify(slot));
            closeAdmin();
            document.getElementById('previewBanner').classList.add('active');
            updateAppForce(previewSlotOverride);
        }

        function exitPreviewMode() {
            previewSlotOverride = null;
            document.getElementById('previewBanner').classList.remove('active');
            updateApp();
        }

        function handleImageUpload(event, mode, key, index, type) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    updateSlotProp(mode, key, index, type, e.target.result);
                    if (mode === 'weekly') renderWeeklyForm();
                    else renderCustomDateForm();
                };
                reader.readAsDataURL(file);
            }
        }

        function handleSoundUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    currentDesign.customSoundData = e.target.result;
                    alert("Son téléversé !");
                };
                reader.readAsDataURL(file);
            }
        }

        function playTransitionSound() {
            if (currentDesign.customSoundData) {
                new Audio(currentDesign.customSoundData).play().catch(e => console.log(e));
            } else {
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator(), gain = ctx.createGain();
                    osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.3);
                    gain.gain.setValueAtTime(0.3, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.8);
                    osc.connect(gain); gain.connect(ctx.destination);
                    osc.start(); osc.stop(ctx.currentTime + 0.8);
                } catch(e) {}
            }
        }

        function exportDataBackup() {
            const dataToExport = {
                weeklySchedules,
                customDateSchedules,
                currentDesign
            };
            const jsonStr = JSON.stringify(dataToExport, null, 2);
            const blob = new Blob([jsonStr], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `sauvegarde_Affiche_dynamique_CLC_V1_${new Date().toISOString().split('T')[0]}.json`;
            a.click();
            URL.revokeObjectURL(url);
        }

        function importDataBackup(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        const imported = JSON.parse(e.target.result);
                        if (imported.weeklySchedules) weeklySchedules = imported.weeklySchedules;
                        if (imported.customDateSchedules) customDateSchedules = imported.customDateSchedules;
                        if (imported.currentDesign) currentDesign = imported.currentDesign;
                        saveSchedule();
                        alert("Sauvegarde importée avec succès !");
                    } catch(err) {
                        alert("Erreur lors de l'importation du fichier JSON.");
                    }
                };
                reader.readAsText(file);
            }
        }

        function timeToSeconds(t) {
            if(!t) return 0;
            const [h, m] = t.split(':').map(Number);
            return h * 3600 + m * 60;
        }

        const daysNames = ["Dimanche", "Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi"];
        const monthsNames = ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"];

        function updateAppForce(activity) {
            const now = new Date();
            const timeString = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;
            setClockText(timeString);
            document.getElementById('day-indicator').textContent = "MODE PRÉVISUALISATION";
            document.getElementById('activity-title').textContent = activity.title;
            document.getElementById('activity-desc').textContent = activity.desc;
            document.getElementById('activity-picto').src = activity.picto;
            document.getElementById('time-range').textContent = `${activity.start} ➔ ${activity.end} (Aperçu)`;
            document.getElementById('time-remaining').textContent = `Prévisualisation active`;
            document.getElementById('progress-bar').style.width = '65%';
            if(activity.bg) document.documentElement.style.setProperty('--bg-image', `url('${activity.bg}')`);
        }

        function updateApp() {
            if (previewSlotOverride) return;

            const now = new Date();
            const dayOfWeek = now.getDay(), year = now.getFullYear(), month = String(now.getMonth() + 1).padStart(2, '0'), dayOfMonth = String(now.getDate()).padStart(2, '0');
            const currentDateFormatted = `${year}-${month}-${dayOfMonth}`;
            const currentHours = String(now.getHours()).padStart(2, '0'), currentMinutes = String(now.getMinutes()).padStart(2, '0'), currentSeconds = String(now.getSeconds()).padStart(2, '0');
            
            const timeString = `${currentHours}:${currentMinutes}:${currentSeconds}`;
            setClockText(timeString);

            let todaySchedule = (customDateSchedules[currentDateFormatted] && customDateSchedules[currentDateFormatted].length > 0) ? customDateSchedules[currentDateFormatted] : (weeklySchedules[dayOfWeek] || []);
            document.getElementById('day-indicator').textContent = `${daysNames[dayOfWeek]} ${dayOfMonth} ${monthsNames[now.getMonth()]}`;

            const currentTimeStr = `${currentHours}:${currentMinutes}`;
            const currentTotalSeconds = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds();

            let currentActivity = todaySchedule.find(item => currentTimeStr >= item.start && currentTimeStr < item.end);
            if (!currentActivity) {
                currentActivity = { title: "Centre Fermé", desc: "En dehors des horaires d'ouverture.", picto: "https://img.icons8.com/color/96/clock.png", start: "00:00", end: "23:59", bg: "https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=1920&q=80" };
            }

            if (previousActivityTitle !== "" && previousActivityTitle !== currentActivity.title && currentDesign.soundEnabled === "true") {
                playTransitionSound();
            }
            previousActivityTitle = currentActivity.title;

            document.getElementById('activity-title').textContent = currentActivity.title;
            document.getElementById('activity-desc').textContent = currentActivity.desc;
            document.getElementById('activity-picto').src = currentActivity.picto;
            document.getElementById('time-range').textContent = `${currentActivity.start} ➔ ${currentActivity.end}`;
            if(currentActivity.bg) document.documentElement.style.setProperty('--bg-image', `url('${currentActivity.bg}')`);

            const startSec = timeToSeconds(currentActivity.start), endSec = timeToSeconds(currentActivity.end);
            const totalDur = endSec - startSec, elapsedDur = currentTotalSeconds - startSec;
            let percentage = totalDur > 0 ? Math.min(Math.max((elapsedDur / totalDur) * 100, 0), 100) : 0;
            document.getElementById('progress-bar').style.width = `${percentage}%`;

            const remMin = Math.ceil((endSec - currentTotalSeconds) / 60);
            document.getElementById('time-remaining').textContent = remMin > 1 ? `Il reste environ ${remMin} min` : (remMin === 1 ? `Moins d'une minute !` : `Changement imminent !`);
        }

        function openAdmin() {
            applyDesign();
            switchAdminDay(1);
            document.getElementById('adminModal').classList.add('active');
        }

        function closeAdmin() {
            document.getElementById('adminModal').classList.remove('active');
        }

        function switchAdminDay(dayIndex, evt) {
            currentAdminDay = dayIndex;
            document.querySelectorAll('.day-btn').forEach(btn => btn.classList.remove('active'));
            if(evt && evt.target) evt.target.classList.add('active');
            renderWeeklyForm();
        }

        function saveSchedule() {
            for (let day in weeklySchedules) weeklySchedules[day].sort((a, b) => timeToSeconds(a.start) - timeToSeconds(b.start));
            for (let dateKey in customDateSchedules) customDateSchedules[dateKey].sort((a, b) => timeToSeconds(a.start) - timeToSeconds(b.start));
            localStorage.setItem('centre_weekly_schedules', JSON.stringify(weeklySchedules));
            localStorage.setItem('centre_custom_date_schedules', JSON.stringify(customDateSchedules));
            localStorage.setItem('centre_design_clc_v1', JSON.stringify(currentDesign));
            closeAdmin();
            updateApp();
            alert("Configuration enregistrée avec succès !");
        }

        applyDesign();
        setInterval(updateApp, 1000);
        updateApp();
    </script>
</body>
</html>

