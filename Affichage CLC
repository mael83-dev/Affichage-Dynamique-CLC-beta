<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Affiche dynamique CLC V1</title>
    
    <!-- IMPORTS WEB FONTS UNIVERSELS (Google Fonts avec display=swap & WOFF2) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Comic+Neue:ital,wght@0,400;0,700;1,400&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Fredoka:wght@400;600;700&family=Inter:wght@400;600;700;900&family=League+Spartan:wght@400;600;700;900&family=Lobster&family=Montserrat:wght@400;700;900&family=Pacifico&family=Playfair+Display:ital,wght@0,700;1,700&family=Poppins:wght@400;600;700;900&family=Roboto:wght@400;700;900&display=swap" rel="stylesheet">
    
    <!-- WEBFONTS DÉDIÉES (OpenDyslexic & Gagalin) -->
    <style>
        @font-face {
            font-family: 'Gagalin';
            src: url('https://fonts.cdnfonts.com/s/16307/Gagalin-Regular.woff') format('woff');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }
        @font-face {
            font-family: 'OpenDyslexic';
            src: url('https://cdn.jsdelivr.net/npm/open-dyslexic@1.0.3/woff/OpenDyslexic-Regular.woff') format('woff');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        :root {
            --bg-image: url('https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=1920&q=80');
            --primary-color: #ffcc00;
            --container-bg: rgba(0, 0, 0, 0.75);
            --border-color: #ffcc00;
            --progress-border-color: #ffcc00;
            --progress-start-color: #4facfe;
            --progress-end-color: #ff8008;

            /* VISIBILITÉ ET COULEUR DES BORDURES */
            --clock-border-style: solid;
            --clock-bg-style: rgba(0, 0, 0, 0.75);
            --main-border-style: solid;
            --main-bg-style: rgba(0, 0, 0, 0.75);
            --footer-border-style: solid;
            --footer-bg-style: rgba(0, 0, 0, 0.75);
            --progress-border-style: none;
            --picto-border-style: solid;

            /* POSITIONS EN X, Y ET LARGEUR */
            --clock-x: 50%;
            --clock-y: 12%;
            --clock-w: auto;

            --main-x: 50%;
            --main-y: 50%;
            --main-w: 80%;

            --footer-x: 50%;
            --footer-y: 88%;
            --footer-w: 90%;

            /* TAILLES ET POLICES */
            --progress-bar-height: 80px;
            --clock-font-size: 8rem;
            --title-font-size: 3.5rem;
            --desc-font-size: 2rem;
            
            --clock-text-color: #ffffff;
            --day-text-color: #ffcc00;
            --title-text-color: #ffcc00;
            --desc-text-color: #ffffff;
            --footer-text-color: #ffffff;
            
            --app-font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--app-font-family);
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), var(--bg-image) no-repeat center center fixed;
            background-size: cover;
            color: white;
            position: relative;
        }

        /* BANDEAU DE PRÉVISUALISATION ACTIF */
        .preview-banner {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            background: #e67e22;
            color: white;
            padding: 10px;
            text-align: center;
            font-weight: bold;
            font-size: 1.1rem;
            z-index: 1000;
            display: none;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            align-items: center;
            justify-content: center;
            gap: 20px;
        }

        .preview-banner.active {
            display: flex;
        }

        .btn-exit-preview {
            background: #c0392b;
            color: white;
            border: none;
            padding: 5px 15px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }

        /* BOUTON CONFIGURATION DISCRET */
        .btn-admin {
            position: absolute;
            top: 15px;
            left: 15px;
            z-index: 50;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.4);
            color: rgba(255, 255, 255, 0.8);
            width: 48px;
            height: 48px;
            border-radius: 50%;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            backdrop-filter: blur(4px);
            transition: all 0.3s ease;
        }

        .btn-admin:hover, .btn-admin:focus {
            background: rgba(0, 0, 0, 0.8);
            color: #fff;
            border-color: #fff;
            transform: rotate(45deg);
            outline: none;
        }

        /* HORLOGE ET CADRES AUTO-ADAPTATIFS */
        header {
            position: absolute;
            left: var(--clock-x);
            top: var(--clock-y);
            transform: translate(-50%, -50%);
            width: var(--clock-w);
            min-width: max-content;
            max-width: 95vw;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2;
        }

        .clock-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: var(--clock-bg-style);
            padding: 15px 45px;
            border-radius: 24px;
            border: 5px var(--clock-border-style) var(--border-color);
            box-shadow: 0 8px 25px rgba(0,0,0,0.6);
            backdrop-filter: blur(8px);
            width: fit-content;
            max-width: 100%;
        }

        /* HORLOGE FIXE A RENDER MONOSPACE PAR CHIFFRE POUR ANTI-DÉCALAGE ABSOLU */
        .clock {
            font-size: var(--clock-font-size);
            font-weight: 900;
            color: var(--clock-text-color);
            text-shadow: 3px 3px 10px rgba(0,0,0,0.9);
            line-height: 1.05;
            white-space: nowrap;
            display: flex;
            align-items: center;
            justify-content: center;
            font-variant-numeric: tabular-nums lining-nums;
            font-feature-settings: "tnum" 1, "lnum" 1;
        }

        /* Emplacement fixe par caractère pour qu'AUCUNE police ne décale l'horloge */
        .clock-digit {
            display: inline-block;
            width: 0.62em;
            text-align: center;
            flex-shrink: 0;
        }

        .clock-colon {
            display: inline-block;
            width: 0.28em;
            text-align: center;
            flex-shrink: 0;
        }

        .day-indicator {
            font-size: calc(var(--clock-font-size) * 0.22);
            color: var(--day-text-color);
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: 5px;
            text-align: center;
            white-space: nowrap;
        }

        /* ZONE CENTRALE INFOS - ADAPTATIVE */
        main {
            position: absolute;
            left: var(--main-x);
            top: var(--main-y);
            transform: translate(-50%, -50%);
            width: var(--main-w);
            max-width: 95vw;
            min-height: fit-content;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            background: var(--main-bg-style);
            border: 5px var(--main-border-style) var(--border-color);
            padding: 25px 40px;
            border-radius: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.6);
            backdrop-filter: blur(10px);
            z-index: 1;
            overflow-wrap: break-word;
        }

        .picto-container {
            width: 150px;
            height: 150px;
            margin-bottom: 15px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.4);
            flex-shrink: 0;
            border: 4px var(--picto-border-style) var(--border-color);
            overflow: hidden;
        }

        .picto-container img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .activity-title {
            font-size: var(--title-font-size);
            font-weight: 800;
            color: var(--title-text-color);
            margin-bottom: 10px;
            text-transform: uppercase;
            text-shadow: 2px 2px 6px rgba(0,0,0,0.7);
            word-break: break-word;
        }

        .activity-desc {
            font-size: var(--desc-font-size);
            color: var(--desc-text-color);
            line-height: 1.35;
            max-width: 100%;
            word-break: break-word;
        }

        /* PIED DE PAGE JAUGE - ADAPTATIF */
        footer {
            position: absolute;
            left: var(--footer-x);
            top: var(--footer-y);
            transform: translate(-50%, -50%);
            width: var(--footer-w);
            max-width: 98vw;
            background: var(--footer-bg-style);
            border: 5px var(--footer-border-style) var(--border-color);
            padding: 20px 40px;
            border-radius: 25px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 12px;
            backdrop-filter: blur(10px);
            z-index: 3;
        }

        .time-info {
            display: flex;
            justify-content: space-between;
            font-size: clamp(1.4rem, 2.8vh, 2.2rem);
            font-weight: 800;
            color: var(--footer-text-color);
            text-shadow: 2px 2px 4px rgba(0,0,0,0.7);
        }

        .progress-bar-container {
            width: 100%;
            height: var(--progress-bar-height);
            background: rgba(255, 255, 255, 0.2);
            border-radius: 35px;
            overflow: hidden;
            border: 4px var(--progress-border-style) var(--progress-border-color);
            position: relative;
            box-shadow: inset 0 3px 10px rgba(0,0,0,0.6);
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--progress-start-color), var(--progress-end-color));
            border-radius: 28px;
            transition: width 1s linear;
        }

        /* MODAL ADMIN */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0,0,0,0.88);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 100;
            padding: 20px;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-content {
            background: #181826;
            width: 95%;
            max-width: 1250px;
            max-height: 90vh;
            border-radius: 20px;
            padding: 30px;
            overflow-y: auto;
            color: #fff;
            box-shadow: 0 10px 35px rgba(0,0,0,0.9);
            border: 1px solid #444;
            font-family: 'Segoe UI', sans-serif !important;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 1px solid #444;
            padding-bottom: 15px;
        }

        .modal-header h2 {
            font-size: 2rem;
            color: var(--primary-color);
        }

        .close-btn {
            background: #e74c3c;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1.1rem;
        }

        .config-section {
            background: #232336;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
            border: 1px solid #3d3d5c;
        }

        .config-section h3 {
            font-size: 1.3rem;
            color: var(--primary-color);
            margin-bottom: 15px;
        }

        .config-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 15px;
        }

        .field-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .field-group label {
            font-size: 0.9rem;
            color: #ddd;
        }

        .field-group input[type="color"] {
            width: 100%;
            height: 45px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            background: none;
        }

        .field-group select, .field-group input[type="range"], .field-group input[type="file"], .field-group input[type="date"] {
            background: #12121c;
            border: 1px solid #444;
            color: white;
            padding: 8px;
            border-radius: 8px;
            font-size: 1rem;
        }

        .range-value {
            font-size: 0.85rem;
            color: var(--primary-color);
            text-align: right;
        }

        .tab-mode-selector {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }

        .tab-mode-btn {
            background: #12121c;
            border: 2px solid #555;
            color: white;
            padding: 12px 24px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 1.1rem;
            font-weight: bold;
            flex: 1;
            text-align: center;
        }

        .tab-mode-btn.active {
            background: var(--primary-color);
            color: #000;
            border-color: var(--primary-color);
        }

        .day-selector {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .day-btn {
            background: #2a2a40;
            border: 2px solid #555;
            color: white;
            padding: 10px 18px;
            border-radius: 10px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: bold;
            transition: all 0.2s;
        }

        .day-btn.active {
            background: var(--primary-color);
            color: #000;
            border-color: var(--primary-color);
        }

        .admin-item {
            background: #2a2a40;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 15px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .admin-item.full-width {
            grid-template-columns: 1fr;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .form-group label {
            font-size: 0.9rem;
            color: #aaa;
        }

        .form-group input, .form-group textarea {
            background: #12121c;
            border: 1px solid #444;
            color: white;
            padding: 10px;
            border-radius: 8px;
            font-size: 1rem;
        }

        .form-group textarea {
            resize: vertical;
            min-height: 60px;
        }

        .admin-actions {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            gap: 15px;
        }

        .btn-add {
            background: #27ae60;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 10px;
            cursor: pointer;
            font-size: 1.1rem;
            font-weight: bold;
        }

        .btn-save {
            background: var(--primary-color);
            color: #000;
            border: none;
            padding: 12px 24px;
            border-radius: 10px;
            cursor: pointer;
            font-size: 1.1rem;
            font-weight: bold;
            flex: 2;
        }

        .btn-preview-mode {
            background: #2980b9;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 10px;
            cursor: pointer;
            font-size: 1.1rem;
            font-weight: bold;
            flex: 1;
        }
        .btn-preview-mode:hover {
            background: #3498db;
        }

        .btn-delete {
            background: #c0392b;
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
            margin-top: 10px;
            align-self: flex-start;
        }

        .file-upload-preview {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 5px;
        }

        .file-upload-preview img {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            object-fit: cover;
            border: 1px solid #666;
        }

        .btn-test-sound {
            background: #2980b9;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.9rem;
        }

        .range-picker-box {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 15px;
            align-items: center;
            margin-bottom: 20px;
            background: #1a1a2e;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #3d3d5c;
        }

        .btn-apply-range {
            background: #8e44ad;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            height: 45px;
        }
        .btn-apply-range:hover {
            background: #9b59b6;
        }

        /* BANDEAU ET BOUTONS DE SÉCURITÉ DE SAUVEGARDE */
        .backup-box {
            background: #111e2e;
            border: 1px solid #2980b9;
            padding: 15px;
            border-radius: 12px;
            margin-top: 15px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .backup-buttons {
            display: flex;
            gap: 10px;
        }

        .btn-backup {
            background: #34495e;
            color: white;
            border: 1px solid #5d6d7e;
            padding: 8px 15px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            font-size: 0.9rem;
        }
        .btn-backup:hover {
            background: #2c3e50;
        }
    </style>
</head>
<body>

    <!-- BANDEAU DE PRÉVISUALISATION -->
    <div class="preview-banner" id="previewBanner">
        <span>👁️ MODE PRÉVISUALISATION ACTIF — Affichage du créneau sélectionné dans l'administration</span>
        <button class="btn-exit-preview" onclick="exitPreviewMode()">Quitter la prévisualisation</button>
    </div>

    <!-- BOUTON CONFIGURATION DISCRET -->
    <button class="btn-admin" onclick="openAdmin()" title="Configuration">⚙️</button>

    <!-- Horloge -->
    <header>
        <div class="clock-container">
            <div class="clock" id="clock">
                <!-- Structure d'emplacements fixes générée dynamiquement -->
            </div>
            <div class="day-indicator" id="day-indicator">Chargement...</div>
        </div>
    </header>

    <!-- Zone d'informations -->
    <main>
        <div class="picto-container">
            <img id="activity-picto" src="" alt="Pictogramme">
        </div>
        <div class="activity-title" id="activity-title">Chargement...</div>
        <div class="activity-desc" id="activity-desc">Veuillez patienter pendant le chargement du planning.</div>
    </main>

    <!-- Jauge de temps -->
    <footer>
        <div class="time-info">
            <span id="time-range">00:00 - 00:00</span>
            <span id="time-remaining">Temps restant : --</span>
        </div>
        <div class="progress-bar-container">
            <div class="progress-bar" id="progress-bar"></div>
        </div>
    </footer>

    <!-- MODAL DE CONFIGURATION AVANCÉE -->
    <div class="modal-overlay" id="adminModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Configuration Avancée, Couleurs & Polices</h2>
                <button class="close-btn" onclick="closeAdmin()">Fermer ✖</button>
            </div>

            <!-- SECTION PERSONNALISATION DES COULEURS ET POLICES EXTENSIBLES -->
            <div class="config-section">
                <h3>🎨 Personnalisation des Couleurs & Polices</h3>
                <div class="config-grid">
                    <div class="field-group">
                        <label>Police de caractères (12 Choix Web Unifiés)</label>
                        <select id="selectFontFamily" onchange="updateDesignSettings()">
                            <optgroup label="Nouveautés & Impact">
                                <option value="'Gagalin', 'League Spartan', sans-serif">Gagalin (Titre BD / Fort Impact)</option>
                                <option value="'League Spartan', sans-serif">League Spartan (Moderne / Titrage)</option>
                            </optgroup>
                            <optgroup label="Standard / Sans-Serif">
                                <option value="'Segoe UI', Tahoma, Geneva, Verdana, sans-serif">Segoe UI / Standard</option>
                                <option value="'Poppins', sans-serif">Poppins (Moderne & Ronde)</option>
                                <option value="'Inter', sans-serif">Inter (Épuré & Lisible)</option>
                                <option value="'Montserrat', sans-serif">Montserrat (Impactant)</option>
                                <option value="'Roboto', sans-serif">Roboto</option>
                            </optgroup>
                            <optgroup label="Enfantin / Fun / Fantaisie">
                                <option value="'Fredoka', cursive, sans-serif">Fredoka (Arrondie / Enfant)</option>
                                <option value="'Comic Neue', cursive, sans-serif">Comic Neue (Ludique / BD)</option>
                                <option value="'Lobster', cursive, sans-serif">Lobster (Calligraphie Titre)</option>
                                <option value="'Pacifico', cursive, sans-serif">Pacifico (Manuscrit Joyeux)</option>
                            </optgroup>
                            <optgroup label="Accessibilité & Style">
                                <option value="'OpenDyslexic', sans-serif">OpenDyslexic (Accessibilité DYS)</option>
                                <option value="'Courier Prime', monospace">Courier Prime (Rétro / Machine)</option>
                                <option value="'Playfair Display', serif">Playfair Display (Élégant / Serif)</option>
                            </optgroup>
                        </select>
                    </div>
                    <div class="field-group">
                        <label>Couleur des Bordures / Accents</label>
                        <input type="color" id="pickerBorder" onchange="updateDesignSettings()">
                    </div>
                    <div class="field-group">
                        <label>Couleur Liseré Barre de Temps</label>
                        <input type="color" id="pickerProgressBorder" onchange="updateDesignSettings()">
                    </div>
                    <div class="field-group">
                        <label>Affichage Général des Bordures</label>
                        <select id="selectBorderVisibility" onchange="updateDesignSettings()">
                            <option value="visible">Bordures Colorées Visibles</option>
                            <option value="none">Bordures Totalement Masquées / Invisibles</option>
                        </select>
                    </div>
                    <div class="field-group">
                        <label>Couleur de Fond des Blocs</label>
                        <input type="color" id="pickerContainerBg" onchange="updateDesignSettings()">
                    </div>
                    <div class="field-group">
                        <label>Couleur du Texte Horloge</label>
                        <input type="color" id="pickerClockText" onchange="updateDesignSettings()">
                    </div>
                    <div class="field-group">
                        <label>Couleur du Texte Jour</label>
                        <input type="color" id="pickerDayText" onchange="updateDesignSettings()">
                    </div>
                    <div class="field-group">
                        <label>Couleur des Titres d'Activité</label>
                        <input type="color" id="pickerTitleText" onchange="updateDesignSettings()">
                    </div>
                    <div class="field-group">
                        <label>Couleur du Texte Description</label>
                        <input type="color" id="pickerDescText" onchange="updateDesignSettings()">
